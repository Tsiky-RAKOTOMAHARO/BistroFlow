<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane 
    styleClass="dashboard-root"
    stylesheets="@/css/commandes.css" 
    xmlns="http://javafx.com/javafx/21" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="com.projet.ui.controller.CommandeController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- En-tête de recherche compact -->
    <top>
        <VBox styleClass="dashboard-card-compact" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <TextField fx:id="searchField" 
                           promptText="Rechercher une commande..." 
                           styleClass="search-field" 
                           HBox.hgrow="ALWAYS" />
                <Button onAction="#onSearch" 
                        styleClass="button, button-primary" 
                        text="Rechercher" />
            </HBox>
        </VBox>
    </top>

    <!-- Contenu défilable -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent-scroll-pane">
            <content>
                <VBox spacing="16.0">
                    <padding>
                        <Insets bottom="15.0" left="0.0" right="5.0" top="12.0" />
                    </padding>

                    <!-- Carte 1 : Liste des commandes -->
                    <VBox spacing="12.0" styleClass="dashboard-card">
                        <padding>
                            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="card-title" text="Liste des commandes" HBox.hgrow="ALWAYS" />
                        </HBox>

                        <TableView fx:id="commandeTable" 
                                   prefHeight="320.0" 
                                   maxWidth="1.7976931348623157E308" 
                                   styleClass="custom-table">
                            <columns>
                                <TableColumn fx:id="colId" minWidth="60.0" prefWidth="70.0" text="ID" />
                                <TableColumn fx:id="colNomcli" minWidth="120.0" prefWidth="180.0" text="Client" />
                                <TableColumn fx:id="colTypecom" minWidth="90.0" prefWidth="110.0" text="Type" />
                                <TableColumn fx:id="colPaye" minWidth="60.0" prefWidth="70.0" text="Payé" />
                                <TableColumn fx:id="colActions" minWidth="240.0" prefWidth="260.0" text="Actions" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                    <!-- Carte 2 : Formulaire de commande -->
                    <VBox spacing="12.0" styleClass="dashboard-card">
                        <padding>
                            <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <Label styleClass="card-title" text="Détails de la commande" />
                            <Label fx:id="modeLabel" styleClass="badge-info" text="Mode : Création" />
                        </HBox>

                        <!-- Ligne 0 : Sélection rapide depuis une réservation du jour -->
                        <HBox spacing="10.0" alignment="BOTTOM_LEFT">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Réservation du jour" />
                                <ComboBox fx:id="reservationComboBox" 
                                          promptText="-- Choisir une réservation d'aujourd'hui --" 
                                          maxWidth="Infinity" 
                                          styleClass="combo-box, form-control" />
                            </VBox>
                        </HBox>

                        <!-- Ligne 1 : Info Client / Type / Table -->
                        <HBox spacing="10.0" alignment="BOTTOM_LEFT">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Client" />
                                <TextField fx:id="nomcliField" promptText="Nom du client" styleClass="form-control" />
                            </VBox>

                            <VBox spacing="4.0" prefWidth="160.0">
                                <Label styleClass="form-label" text="Type" />
                                <ComboBox fx:id="typecomComboBox" maxWidth="Infinity" styleClass="combo-box, form-control" />
                            </VBox>

                            <VBox spacing="4.0" prefWidth="140.0">
                                <Label styleClass="form-label" text="Table" />
                                <ComboBox fx:id="tableComboBox" maxWidth="Infinity" styleClass="combo-box, form-control" />
                            </VBox>
                        </HBox>

                        <!-- Ligne 2 : Saisie rapide des plats -->
                        <HBox alignment="BOTTOM_LEFT" spacing="8.0">
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <Label styleClass="form-label" text="Plat" />
                                <ComboBox fx:id="platComboBox" maxWidth="Infinity" promptText="Sélectionner un plat..." styleClass="combo-box, form-control" />
                            </VBox>
                            
                            <VBox spacing="4.0" prefWidth="70.0">
                                <Label styleClass="form-label" text="Qté" />
                                <TextField fx:id="quantiteField" promptText="1" styleClass="form-control" />
                            </VBox>

                            <Button onAction="#onAjouterLigne" styleClass="button, button-secondary" text="+ Ajouter" prefHeight="38.0" />
                        </HBox>

                        <!-- Tableau des lignes compact -->
                        <TableView fx:id="lignesTable" 
                                   prefHeight="130.0" 
                                   maxHeight="160.0" 
                                   maxWidth="1.7976931348623157E308" 
                                   styleClass="custom-table">
                            <columns>
                                <TableColumn fx:id="colLignePlat" minWidth="150.0" prefWidth="240.0" text="Plat" />
                                <TableColumn fx:id="colLigneQuantite" minWidth="50.0" prefWidth="60.0" text="Qté" />
                                <TableColumn fx:id="colLignePu" minWidth="70.0" prefWidth="80.0" text="PU" />
                                <TableColumn fx:id="colLigneActions" minWidth="40.0" prefWidth="50.0" text="" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Pied de formulaire -->
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <Label fx:id="totalLabel" styleClass="card-title" text="Total : 0 Ar" />
                            <Button onAction="#onSave" styleClass="button, button-success" text="Enregistrer" prefWidth="130.0" prefHeight="38.0" />
                        </HBox>

                        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>