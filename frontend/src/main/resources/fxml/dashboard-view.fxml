<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox 
    spacing="24.0" 
    styleClass="dashboard-root" 
    stylesheets="@/css/dashboard.css" 
    xmlns="http://javafx.com/javafx/21" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="com.projet.ui.controller.DashboardController">

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label styleClass="page-title" text="Dashboard" />
        <Label fx:id="errorLabel" styleClass="error-label" />
    </HBox>

    <HBox spacing="24.0">
        <VBox styleClass="kpi-card">
            <Label styleClass="kpi-title" text="Recette Totale" />
            <Label fx:id="totalRecetteLabel" styleClass="kpi-value" text="0 Ar" />
        </VBox>
        <VBox styleClass="kpi-card">
            <Label styleClass="kpi-title" text="Nombre de Tables" />
            <Label fx:id="totalTablesLabel" styleClass="kpi-value" text="0" />
        </VBox>
        <VBox styleClass="kpi-card">
            <Label styleClass="kpi-title" text="Plats Actifs" />
            <Label fx:id="totalMenusLabel" styleClass="kpi-value" text="0" />
        </VBox>
    </HBox>

    <HBox spacing="24.0">
        <VBox styleClass="dashboard-card">
            <Label styleClass="card-title" text="Évolution sur les 6 Derniers Mois" />
            <BarChart fx:id="monthlyBarChart">
                <xAxis>
                    <CategoryAxis label="Mois" side="BOTTOM" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Valeur" side="LEFT" />
                </yAxis>
            </BarChart>
        </VBox>

        <VBox prefWidth="380.0" styleClass="dashboard-card">
            <Label styleClass="card-title" text="Top 10 Plats les Plus Commandés" />
            <TableView fx:id="topPlatsTable">
                <columns>
                    <TableColumn fx:id="colNomPlat" prefWidth="220.0" text="Plat" />
                    <TableColumn fx:id="colQuantite" prefWidth="90.0" text="Ventes" />
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>