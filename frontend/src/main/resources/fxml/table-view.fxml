<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.CheckBox?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.projet.ui.controller.TableController">

    <top>
        <VBox styleClass="card, search-card" BorderPane.alignment="CENTER">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Rechercher une table..."/>
                <Button text="Rechercher" onAction="#onSearch" styleClass="button-search"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.65">

            <VBox styleClass="card, table-card" spacing="10">
                <Label text="Liste des tables" styleClass="card-title"/>
                <Button text="Nouveau" onAction="#onNew" styleClass="button-secondary"/>

                <TableView fx:id="tableTable">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colDesignation" text="Désignation" prefWidth="150"/>
                        <TableColumn fx:id="colOccupation" text="Occupée" prefWidth="90"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="190"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox styleClass="card, form-card" spacing="12">
                <Label text="Détails de la table" styleClass="card-title"/>
                <Label fx:id="modeLabel" text="Mode : Création" styleClass="card-subtitle"/>

                <VBox spacing="5">
                    <Label text="ID de la table :"/>
                    <TextField fx:id="idTableField" promptText="Ex: T1"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Désignation :"/>
                    <TextField fx:id="designationField" promptText="Ex: Table Terrasse 1"/>
                </VBox>

                <CheckBox fx:id="occupationCheckBox" text="Table occupée"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Enregistrer" onAction="#onSave" styleClass="button-primary"/>
                </HBox>

                <Label fx:id="errorLabel" wrapText="true" styleClass="error-label"/>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>