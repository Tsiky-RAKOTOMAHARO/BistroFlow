<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane 
    styleClass="dashboard-root" 
    stylesheets="@/css/menus.css" 
    xmlns="http://javafx.com/javafx/21" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="com.projet.ui.controller.MenuController">

    <top>
        <VBox styleClass="dashboard-card" BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <TextField fx:id="searchField" promptText="Rechercher un plat..." />
                <Button onAction="#onSearch" styleClass="button" text="Rechercher" />
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.65" styleClass="transparent-split-pane">
            <items>
                <VBox spacing="15.0" styleClass="dashboard-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="card-title" text="Liste des menus" />
                        <Button onAction="#onNew" styleClass="button" text="Nouveau" />
                    </HBox>

                    <TableView fx:id="menuTable">
                        <columns>
                            <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                            <TableColumn fx:id="colNom" prefWidth="200.0" text="Nom du plat" />
                            <TableColumn fx:id="colPrix" prefWidth="110.0" text="Prix (Ar)" />
                            <TableColumn fx:id="colActions" prefWidth="140.0" text="Actions" />
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="15.0" styleClass="dashboard-card">
                    <Label styleClass="card-title" text="Détails du menu" />
                    <Label fx:id="modeLabel" styleClass="subtitle" text="Mode : Création" />

                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="Nom du plat :" />
                        <TextField fx:id="nomField" promptText="Ex: Pizza Margherita" />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label styleClass="subtitle" text="Prix (PU) :" />
                        <TextField fx:id="prixField" promptText="Ex: 12500" />
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Button onAction="#onSave" styleClass="button" text="Enregistrer" />
                    </HBox>

                    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />
                </VBox>
            </items>
        </SplitPane>
    </center>

</BorderPane>