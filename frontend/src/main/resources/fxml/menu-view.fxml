<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.projet.ui.controller.MenuController">

    <top>
        <VBox styleClass="card, search-card" BorderPane.alignment="CENTER">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Rechercher..."/>
                <Button text="Rechercher" onAction="#onSearch"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.65">

            <VBox styleClass="card, table-card" spacing="10">
                <Label text="Liste des menus" styleClass="card-title"/>
                <TableView fx:id="menuTable">
                    <columns>
                        <TableColumn fx:id="colId" text="ID"/>
                        <TableColumn fx:id="colNom" text="Nom"/>
                        <TableColumn fx:id="colPrix" text="Prix"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox styleClass="card, form-card" spacing="10">

                <Label text="Détails du menu" styleClass="card-title"/>
                <Label fx:id="modeLabel" text="Mode : Création" styleClass="card-subtitle"/>

                <VBox spacing="5">
                    <Label text="Nom du plat :"/>
                    <TextField fx:id="nomField" promptText="Ex: Pizza Margherita"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Prix (PU) :"/>
                    <TextField fx:id="prixField" promptText="Ex: 12"/>
                </VBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="Enregistrer" onAction="#onSave"/>
                    <Button text="Nouveau" onAction="#onNew"/>
                    <Button text="Supprimer" onAction="#onDelete"/>
                </HBox>

                <Label fx:id="errorLabel" wrapText="true" styleClass="error-label"/>
            </VBox>

        </SplitPane>
    </center>

</BorderPane>